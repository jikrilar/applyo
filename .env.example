# Browser-safe Supabase project values. The publishable key is expected to be
# public and still relies on Row Level Security for data isolation.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Used exclusively by the guarded account-deletion admin client.
# Never prefix this value with NEXT_PUBLIC_ or expose it to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
